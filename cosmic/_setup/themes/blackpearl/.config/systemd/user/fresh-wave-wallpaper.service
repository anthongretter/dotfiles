[Unit]
Description=Blackpearl wave animated wallpaper (mpvpaper)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
# Intro (rising tide) plays once, then 44s..164s loops forever.
ExecStart=/usr/local/bin/mpvpaper -l bottom -o "really-quiet no-audio panscan=1.0 hwdec=auto ab-loop-a=44 ab-loop-b=164 ab-loop-count=inf" '*' %h/Videos/wallpapers/blackpearl-wave.webm
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
