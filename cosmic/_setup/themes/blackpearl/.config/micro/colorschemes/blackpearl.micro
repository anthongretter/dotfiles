# blackpearl: sea green on opaque black/gray
color-link default "#c9d1cb,#101010"
color-link comment "#6d6d6d"
color-link constant "#a096cc"
color-link constant.string "#7fe0a0"
color-link constant.string.char "#7fe0a0"
color-link constant.number "#a096cc"
color-link identifier "#5fd1b5"
color-link statement "#3cb371"
color-link symbol "#b8bfb9"
color-link symbol.operator "#d9b85a"
color-link preproc "#5ba3bd"
color-link type "#d9b85a"
color-link special "#5fd1b5"
color-link underlined "#5ba3bd"
color-link error "bold #d9695f"
color-link todo "bold #d9b85a"
color-link hlsearch "#101010,#3cb371"
color-link statusline "#101010,#3cb371"
color-link tabbar "#101010,#3cb371"
color-link indent-char "#2e2e2e"
color-link line-number "#6d6d6d,#101010"
color-link current-line-number "#3cb371,#181818"
color-link diff-added "#7fe0a0"
color-link diff-modified "#d9b85a"
color-link diff-deleted "#d9695f"
color-link gutter-error "#d9695f"
color-link gutter-warning "#d9b85a"
color-link cursor-line "#181818"
color-link color-column "#181818"
color-link selection "#e6ece7,#1f4a33"
color-link match-brace "#101010,#5fd1b5"
color-link message "#c9d1cb"
color-link error-message "#101010,#d9695f"
color-link divider "#2e2e2e"
color-link scrollbar "#484848"
